#### POSTGRESQL ####

DATABASE_URL = postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxx.supabase.co:PORT/postgres

#### DISCORD SECRETS ####

TOKEN = token_of_your_bot_via_discord_developper_portal

#### MONGODB ####

MONGO_URI = mongodb+srv://<db_username>:<db_password>@yourbot.xxxxxx.mongodb.net/

MONGO_USER = yourname_db_user
MONGO_PASSWORD = somecoolpassword
MONGO_HOST = yourbot.xxxxxx.mongodb.net
MONGO_DB = YourBot

